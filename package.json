{
  "name": "artifacts-share",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "vendor": "node scripts/vendor.mjs",
    "dev": "npm run vendor && node scripts/dev.mjs",
    "deploy": "npm run vendor && npm run db:migrate:remote && wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply artifacts-share --local",
    "db:migrate:remote": "wrangler d1 migrations apply artifacts-share --remote",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run vendor",
    "test": "vitest run"
  },
  "dependencies": {
    "@zip.js/zip.js": "^2.25.0",
    "fflate": "^0.8.3",
    "github-slugger": "^2.0.0",
    "highlight.js": "^11.12.0",
    "hono": "^4.13.17",
    "markdown-it": "^15.0.3",
    "mermaid": "^12.3.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.6.1",
    "@cloudflare/workers-types": "^5.20261110.1",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12",
    "wrangler": "^4.159.0"
  }
}
